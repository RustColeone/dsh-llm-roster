{
  "_": "Which character and tier each model is. Tiers go weakest to strongest; each has one card picture per character (art/<character>/<tier>.webp) and a rarity. A model in `models` is that exact pick; any other is matched by `match` (its id, without any 'vendor/' prefix) or by its provider, and its tier by the words in its id (`words`, first hit wins; else `fallback`). `home` is the provider the roster offers a character's models from when DSH does not offer them yet; the models in `models` are the roster's lineup, shown even before you can use them. Your own picks in the roster's settings win over all of this.",
  "tiers": {
    "chibi": {
      "name": "Chibi",
      "zh": "Q版",
      "rarity": "R"
    },
    "middle": {
      "name": "Middle-schooler",
      "zh": "初中生",
      "rarity": "SR"
    },
    "high": {
      "name": "High-schooler",
      "zh": "高中生",
      "rarity": "SSR"
    },
    "university": {
      "name": "University student",
      "zh": "大学生",
      "rarity": "UR"
    }
  },
  "characters": {
    "gpt": {
      "name": "GPT",
      "home": "openai",
      "match": [
        "^gpt",
        "^o\\d",
        "^chatgpt",
        "^codex",
        "^openai"
      ],
      "providers": [
        "openai",
        "openai-codex",
        "azure"
