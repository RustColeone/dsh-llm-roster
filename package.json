  "type": "module",
  "license": "MIT AND CC-BY-NC-SA-4.0",
  "author": "RustColeone",
  "engines": {
    "node": ">=22.13"
  },
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./server": "./plugin/server.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "art",
    "data",
    "cordis.patch.yml",
    "packs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "model picker",
    "gacha",
    "roster"
  ],
  "scripts": {
    "test": "node --test"
  },
  "optionalDependencies": {
