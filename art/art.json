      ]
    },
    "kimi": { "name": "Kimi", "home": "openrouter", "vendor": "moonshotai", "match": ["^kimi", "^moonshot"],
      "providers": ["moonshotai", "moonshotai-cn", "kimi-coding"] },
    "glm": { "name": "GLM", "home": "openrouter", "vendor": "z-ai", "match": ["^glm", "^chatglm", "^zhipu"],
      "providers": ["zai", "zai-coding-cn"] },
    "qwen": { "name": "Qwen", "home": "openrouter", "vendor": "qwen", "match": ["^qwen", "^qwq"],
      "providers": ["qwen-token-plan", "qwen-token-plan-cn", "qwen-token-plan-individual"] },
    "mistral": { "name": "Mistral", "home": "openrouter", "vendor": "mistralai",
      "match": ["^mistral", "^ministral", "^magistral", "^devstral", "^codestral", "^pixtral"], "providers": ["mistral"] },
    "minimax": { "name": "MiniMax", "home": "openrouter", "vendor": "minimax", "match": ["^minimax", "^abab"],
