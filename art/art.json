    "llama": { "name": "Llama", "home": "openrouter", "vendor": "meta-llama", "match": ["^llama", "^meta-llama"],
      "providers": ["meta"] },
    "doubao": { "name": "Doubao", "home": "openrouter", "vendor": "bytedance-seed", "match": ["^seed-", "^doubao"],
